# Copiar a .env (que esta en .gitignore) y ajustar si hace falta.
# Los valores por defecto coinciden con el docker-compose.yml del repo.

# Puerto 5433, no 5432: ver el comentario de ports en docker-compose.yml.
BASE_URL=postgresql+psycopg://exonero:exonero@localhost:5433/exonero

# Clave con la que se firman los tokens. En produccion seria un secreto real;
# para el trabajo de facultad alcanza cualquier cadena larga.
JWT_SECRETO=cambiar-esta-clave-en-cada-maquina
JWT_HORAS_VALIDO=24

# Origenes que pueden llamar a la API (el dev server de Vite).
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Privacidad y correo de desarrollo. Mailpit queda en http://localhost:8025.
MODO_DEMO=true
URL_FRONTEND=http://localhost:5173
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_REMITENTE=privacidad@exonero.local
RESPONSABLE_DATOS=PENDIENTE - PROTOTIPO ACADEMICO
CONTACTO_PRIVACIDAD=privacidad@exonero.local
